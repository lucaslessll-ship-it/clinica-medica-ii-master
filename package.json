{
  "name": "clinica-medica-ii-master",
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/*.test.cjs",
    "build:ai-index": "node scripts/build-ai-index.cjs",
    "build": "vite build",
    "pretest": "npm run build",
    "test:optimized": "npm run build && node --test tests/optimized-site.test.cjs",
    "audit:performance": "lhci autorun",
    "eval:ai": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval --config evaluations/promptfooconfig.yaml --no-cache --no-write --output evaluations/results/report.json",
    "eval:validate": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo validate --config evaluations/promptfooconfig.yaml"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@supabase/supabase-js": "2.119.0",
    "esbuild": "0.28.2",
    "minisearch": "7.2.0",
    "playwright": "1.62.1",
    "promptfoo": "0.125.1",
    "ts-fsrs": "6.0.0",
    "vite": "8.3.8"
  }
}
